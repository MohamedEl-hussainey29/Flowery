pipeline {
    agent any

    environment {
        DOCKER_USER   = "amrnagy74"
        IMAGE_TAG     = "${env.GIT_COMMIT.take(7)}"
        TARGET_BRANCH = "main"
    }

    stages {
        stage('1. Checkout') {
            steps {
                checkout scm
            }
        }

        stage('2. Inject Secrets') {
            when {
                expression { return env.BRANCH_NAME == env.TARGET_BRANCH || env.GIT_BRANCH?.endsWith(env.TARGET_BRANCH) }
            }
            steps {
                withCredentials([
                    file(credentialsId: 'backend-env-file', variable: 'ENV_FILE'),
                    file(credentialsId: 'firebase-service-account', variable: 'FIREBASE_FILE')
                ]) {
                    sh '''
                        cp "$ENV_FILE" backend/.env
                        mkdir -p backend/secrets
                        cp "$FIREBASE_FILE" backend/secrets/firebase-service-account.json
                        echo "Secrets injected for testing and build."
                    '''
                }
            }
        }

        stage('3. Run Test Cases') {
            when {
                expression { return env.BRANCH_NAME == env.TARGET_BRANCH || env.GIT_BRANCH?.endsWith(env.TARGET_BRANCH) }
            }
            steps {
                echo "Running backend test cases on branch: ${TARGET_BRANCH}..."
                sh '''
                    if command -v dotnet &> /dev/null; then
                        dotnet test backend/FlowersApp.slnx --configuration Release --logger "console;verbosity=normal"
                    else
                        echo "WARNING: dotnet SDK is not installed on this machine. Please install dotnet-sdk to run actual tests!"
                        exit 0
                    fi
                '''
            }
        }

        stage('4. Build & Push Docker Images') {
            when {
                expression { return env.BRANCH_NAME == env.TARGET_BRANCH || env.GIT_BRANCH?.endsWith(env.TARGET_BRANCH) }
            }
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: 'dockerhub-credentials', usernameVariable: 'DOCKER_PASS_USER', passwordVariable: 'DOCKER_PASS')]) {
                        sh 'echo "$DOCKER_PASS" | docker login -u "$DOCKER_PASS_USER" --password-stdin'

                        // 1. build Frontend image
                        echo "Building and pushing Frontend image..."
                        sh """
                            docker build -t ${DOCKER_USER}/flowery-frontend:${IMAGE_TAG} -t ${DOCKER_USER}/flowery-frontend:latest ./frontend
                            docker push ${DOCKER_USER}/flowery-frontend:${IMAGE_TAG}
                            docker push ${DOCKER_USER}/flowery-frontend:latest
                        """

                        // 2. build & push the 6 Backend 
                        def backendServices = [
                            'apigateway'        : 'src/ApiGateway/Dockerfile',
                            'addresscartservice': 'src/Services/AddressCartService/Dockerfile',
                            'ordersservice'     : 'src/Services/OrdersService/Dockerfile',
                            'paymentservice'    : 'src/Services/PaymentService/Dockerfile',
                            'identityservice'   : 'src/Services/IdentityService/Dockerfile',
                            'catalogservice'    : 'src/Services/CatalogService/Dockerfile'
                        ]

                        backendServices.each { serviceName, dockerfilePath ->
                            echo "Building and pushing ${serviceName} image..."
                            sh """
                                docker build -t ${DOCKER_USER}/flowery-${serviceName}:${IMAGE_TAG} -t ${DOCKER_USER}/flowery-${serviceName}:latest -f backend/${dockerfilePath} ./backend
                                docker push ${DOCKER_USER}/flowery-${serviceName}:${IMAGE_TAG}
                                docker push ${DOCKER_USER}/flowery-${serviceName}:latest
                            """
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            // remove all secrets & logut from DockerHub after each run 
            sh '''
                rm -f backend/.env
                rm -rf backend/secrets
                docker logout || true
            '''
        }
        success {
            echo "CI Pipeline completed! Tests passed and all 7 images pushed to Docker Hub (${IMAGE_TAG})."
        }
        failure {
            echo "CI Pipeline failed! Either tests failed or image build/push encountered an error."
        }
    }
}